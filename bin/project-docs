name: project-docs

on:
  pull_request_target:
    types: [opened, synchronize, reopened, edited, labeled, unlabeled]

permissions:
  contents: read

# Advisory only: pull_request_target checks default-branch PRs with default-branch code but its
# status is not a hard gate on the PR head. Do not configure this job as a required check.
# Use an independently provisioned GitHub App or organization required workflow when a
# fail-closed merge gate (including Merge Queue) is required.
jobs:
  doctor:
    if: github.event.action != 'edited' || github.event.changes.base != null
    runs-on: ubuntu-latest
    steps:
      - name: Require the repository default branch as PR base
        env:
          PR_BASE_REF: ${{ github.event.pull_request.base.ref }}
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          if [ "$PR_BASE_REF" != "$DEFAULT_BRANCH" ]; then
            echo "project-docs advisory check supports only the repository default branch" >&2
            exit 1
          fi
      - name: Checkout proposed repository state
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          repository: ${{ github.event.pull_request.head.repo.full_name }}
          ref: ${{ github.event.pull_request.head.sha }}
          path: candidate
          persist-credentials: false
          allow-unsafe-pr-checkout: true
      - name: Checkout trusted project-docs gate
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          ref: ${{ github.sha }}
          path: trusted
          persist-credentials: false
      - name: Require independent review for managed gate updates
        env:
          MANAGED_UPDATE_REVIEW_EVENT: ${{ github.event.action == 'labeled' && github.event.label.name == 'project-docs-upgrade-reviewed' }}
        run: |
          if cmp -s trusted/.github/project-docs/project-docs candidate/.github/project-docs/project-docs &&
            cmp -s trusted/.github/workflows/project-docs.yml candidate/.github/workflows/project-docs.yml; then
            echo "PROJECT_DOCS_MANAGED_UPDATE=false" >> "$GITHUB_ENV"
            exit 0
          fi
          if [ "$MANAGED_UPDATE_REVIEW_EVENT" != "true" ]; then
            echo "managed project-docs files changed; remove and reapply project-docs-upgrade-reviewed after reviewing the current head" >&2
            exit 1
          fi
          echo "::warning::Managed project-docs update was independently reviewed; candidate code will not execute"
          echo "PROJECT_DOCS_MANAGED_UPDATE=true" >> "$GITHUB_ENV"
      - name: Validate pull request with trusted gate
        run: |
          args=(doctor --repo candidate --strict)
          if [ "$PROJECT_DOCS_MANAGED_UPDATE" = "true" ]; then
            args+=(--allow-reviewed-managed-update)
          fi
          python3 trusted/.github/project-docs/project-docs "${args[@]}"
"""
