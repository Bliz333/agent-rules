TOOL_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE_ROOT = TOOL_ROOT / "project-template"
AGENT_RULES_HOME_ENV = "AGENT_RULES_HOME"
DEFAULT_INSTALL_DIRNAME = ".agent-rules"


def install_root() -> Path:
    """Where this rules repo is expected to live when installed for a user."""
    configured = os.environ.get(AGENT_RULES_HOME_ENV)
    if configured:
        return Path(configured).expanduser()
    return Path.home() / DEFAULT_INSTALL_DIRNAME


def display_path(path: Path) -> str:
    """Render a path with a leading ~ when it lives under the home directory."""
    try:
        return "~/" + str(path.relative_to(Path.home()))
    except ValueError:
        return str(path)


def shell_path(path: Path) -> str:
    """Render a path for a copy-pasteable shell command.

    ``~/...`` is kept only when the part after ``~`` needs no quoting (so the
    tilde still expands); anything else becomes a quoted absolute path.
    """
    rendered = display_path(path)
    if rendered.startswith("~/") and shlex.quote(rendered[2:]) == rendered[2:]:
        return rendered
    if shlex.quote(rendered) == rendered:
        return rendered
    return shlex.quote(str(path))


